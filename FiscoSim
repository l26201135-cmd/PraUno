# FiscoSim - Simulador de Gestión Fiscal y Educación Financiera

from datetime import datetime

TASA_IVA = 0.16
TASA_ISR_MORAL = 0.30   # Tasa general de ISR para personas morales
TASA_PTU = 0.10         # Reparto de utilidades a los trabajadores (referencia)

ingresos = []
gastos = []
deducciones_personales = []   # Solo persona física
perdidas_anteriores = []      # Solo persona moral


# ---------------------------------------------------------------
# Entrada de datos
# ---------------------------------------------------------------

def leer_monto(mensaje):
    while True:
        try:
            valor = float(input(mensaje))
            if valor > 0:
                return valor
            else:
                print("Monto inválido, escribe un número mayor que 0")
        except ValueError:
            print("Monto inválido, escribe un número mayor que 0")

def elegir_tipo_contribuyente():
    print("Tipo de contribuyente:")
    print("1. Persona física (una persona: freelance, comerciante, profesionista...)")
    print("2. Persona moral (una empresa o sociedad: S.A., S. de R.L., A.C....)")
    while True:
        opcion = input("Elige una opción (1-2): ").strip()
        if opcion == "1":
            return "fisica"
        elif opcion == "2":
            return "moral"
        print("Opción no válida, escribe 1 o 2")

def nombre_tipo(tipo):
    return "Persona física" if tipo == "fisica" else "Persona moral"


# ---------------------------------------------------------------
# Registros
# ---------------------------------------------------------------

def registrar_ingreso():
    concepto = input("Concepto de ingreso: ")
    monto = leer_monto("Monto antes de IVA: ")
    ingresos.append({"concepto": concepto, "monto": monto})
    print("Ingreso registrado.\n")

def registrar_gasto():
    concepto = input("Concepto de gasto: ")
    monto = leer_monto("Monto antes de IVA: ")
    tiene_factura = input("¿Tiene factura? (s/n): ").lower() == 's'
    categoria_permitida = input("¿Es de categoría permitida? (s/n): ").lower() == 's'
    deducible = tiene_factura and categoria_permitida
    if not deducible:
        print("Este gasto no es deducible")
    gastos.append({"concepto": concepto, "monto": monto, "deducible": deducible})
    print("Gasto registrado.\n")

def registrar_deduccion_personal():
    """Solo persona física: gastos médicos, colegiaturas, intereses de hipoteca, etc."""
    concepto = input("Concepto de deducción personal (médicos, colegiaturas, seguro...): ")
    monto = leer_monto("Monto de la deducción: ")
    deducciones_personales.append({"concepto": concepto, "monto": monto})
    print("Deducción personal registrada.\n")

def registrar_perdida_anterior():
    """Solo persona moral: pérdidas fiscales de ejercicios anteriores."""
    concepto = input("Ejercicio o concepto de la pérdida (ej. 'Pérdida 2025'): ")
    monto = leer_monto("Monto de la pérdida fiscal: ")
    perdidas_anteriores.append({"concepto": concepto, "monto": monto})
    print("Pérdida fiscal registrada.\n")


# ---------------------------------------------------------------
# Cálculo de impuestos
# ---------------------------------------------------------------

def calcular_isr(utilidad):
    """ISR de persona física (tarifa progresiva simplificada)."""
    if utilidad <= 0:
        return 0
    elif utilidad <= 100000:
        return 0 + 0.05 * utilidad
    elif utilidad <= 250000:
        return 5000 + 0.15 * (utilidad - 100000)
    elif utilidad <= 500000:
        return 27500 + 0.25 * (utilidad - 250000)
    else:
        return 90000 + 0.30 * (utilidad - 500000)

def calcular_isr_moral(utilidad_fiscal):
    """ISR de persona moral: tasa general del 30% sobre la utilidad fiscal."""
    if utilidad_fiscal <= 0:
        return 0
    return TASA_ISR_MORAL * utilidad_fiscal

def calcular_y_mostrar(nombre, tipo, tipo_actividad):
    if not ingresos:
        print("Primero registra al menos un ingreso\n")
        return

    total_ingresos = sum(i["monto"] for i in ingresos)
    total_gastos_deducibles = sum(g["monto"] for g in gastos if g["deducible"])
    utilidad = total_ingresos - total_gastos_deducibles

    # ISR según el tipo de contribuyente
    if tipo == "fisica":
        total_deducciones = sum(d["monto"] for d in deducciones_personales)
        base_gravable = max(utilidad - total_deducciones, 0)
        isr = calcular_isr(base_gravable)
    else:
        total_perdidas = sum(p["monto"] for p in perdidas_anteriores)
        base_gravable = max(utilidad - total_perdidas, 0)
        isr = calcular_isr_moral(base_gravable)

    iva_trasladado = total_ingresos * TASA_IVA
    iva_acreditable = total_gastos_deducibles * TASA_IVA
    iva_diferencia = iva_trasladado - iva_acreditable
    if iva_diferencia > 0:
        iva_a_pagar = iva_diferencia
        saldo_a_favor = 0
    else:
        iva_a_pagar = 0
        saldo_a_favor = -iva_diferencia
    total_a_pagar = isr + iva_a_pagar

    # Mostrar el resumen
    print(f"\nResumen fiscal para {nombre} ({nombre_tipo(tipo)} - {tipo_actividad}):")
    print(f"Ingresos totales: ${total_ingresos:.2f}")
    print(f"Gastos deducibles totales: ${total_gastos_deducibles:.2f}")
    print(f"Utilidad (Ingresos - Gastos deducibles): ${utilidad:.2f}")
    if tipo == "fisica":
        print(f"Deducciones personales: ${total_deducciones:.2f}")
        print(f"Base gravable (Utilidad - Deducciones personales): ${base_gravable:.2f}")
        print(f"ISR aproximado a pagar (tarifa progresiva): ${isr:.2f}")
    else:
        print(f"Pérdidas fiscales de ejercicios anteriores aplicadas: ${min(total_perdidas, max(utilidad, 0)):.2f}")
        print(f"Utilidad fiscal (Utilidad - Pérdidas anteriores): ${base_gravable:.2f}")
        print(f"ISR aproximado a pagar (tasa {TASA_ISR_MORAL * 100:.0f}%): ${isr:.2f}")
    print(f"IVA trasladado (16% de ingresos): ${iva_trasladado:.2f}")
    print(f"IVA acreditable (16% de gastos deducibles): ${iva_acreditable:.2f}")
    if iva_a_pagar > 0:
        print(f"IVA a pagar: ${iva_a_pagar:.2f}")
    else:
        print(f"Saldo a favor de IVA: ${saldo_a_favor:.2f}")
    print(f"Total aproximado a pagar (ISR + IVA a pagar): ${total_a_pagar:.2f}")
    if tipo == "moral":
        ptu = max(utilidad, 0) * TASA_PTU
        print(f"Referencia: PTU estimada (10% de la utilidad, se reparte a los trabajadores): ${ptu:.2f}")
    print()

    guardar_historial(nombre, tipo, utilidad, isr, iva_a_pagar, total_a_pagar)


# ---------------------------------------------------------------
# Historial y listados
# ---------------------------------------------------------------

def guardar_historial(nombre, tipo, utilidad, isr, iva_a_pagar, total_a_pagar):
    with open("historial_fiscosim.txt", "a", encoding="utf-8") as f:
        fecha = datetime.now().strftime("%Y-%m-%d %H:%M")
        f.write(f"{fecha} - {nombre} ({nombre_tipo(tipo)}) - Utilidad: {utilidad:.2f}, ISR: {isr:.2f}, IVA a pagar: {iva_a_pagar:.2f}, Total a pagar: {total_a_pagar:.2f}\n")

def ver_historial():
    try:
        with open("historial_fiscosim.txt", "r", encoding="utf-8") as f:
            print("\nHistorial de simulaciones:")
            for linea in f:
                print(linea, end='')
            print()
    except FileNotFoundError:
        print("No hay historial guardado.\n")

def listar_registros(tipo):
    print("\nIngresos registrados:")
    for i in ingresos:
        print(f"- {i['concepto']}: ${i['monto']:.2f}")
    print("\nGastos registrados:")
    for g in gastos:
        ded = "Deducible" if g["deducible"] else "No deducible"
        print(f"- {g['concepto']}: ${g['monto']:.2f} ({ded})")
    if tipo == "fisica":
        print("\nDeducciones personales registradas:")
        for d in deducciones_personales:
            print(f"- {d['concepto']}: ${d['monto']:.2f}")
    else:
        print("\nPérdidas fiscales de ejercicios anteriores:")
        for p in perdidas_anteriores:
            print(f"- {p['concepto']}: ${p['monto']:.2f}")
    print()



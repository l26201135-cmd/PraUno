def modulo_educacion(tipo):
    preguntas = list(PREGUNTAS_GENERALES)
    preguntas.append(PREGUNTA_FISICA if tipo == "fisica" else PREGUNTA_MORAL)
    total = len(preguntas)

    aciertos = 0
    for p in preguntas:
        print("\n" + p["pregunta"])
        for clave, texto in p["opciones"].items():
            print(f"  {clave}) {texto}")

        while True:
            respuesta = input("Tu respuesta (a/b/c): ").lower().strip()
            if respuesta in p["opciones"]:
                break
            print("Opción no válida, escribe a, b o c")

        if respuesta == p["correcta"]:
            print("Correcto.")
            aciertos += 1
        else:
            correcta_texto = p["opciones"][p["correcta"]]
            print(f"Incorrecto. La respuesta correcta era {p['correcta']}) {correcta_texto}.")
        print(f"Explicación: {p['explicacion']}")
        print(f"Para aprender más: {p['info']}")

    if aciertos == total:
        nivel = "Experto"
    elif aciertos >= 3:
        nivel = "Intermedio"
    else:
        nivel = "Principiante"

    print(f"\nAcertaste {aciertos} de {total} preguntas. Nivel: {nivel}\n")


# ---------------------------------------------------------------
# Menú
# ---------------------------------------------------------------

def opciones_menu(tipo):
    """Devuelve la lista de (clave, texto) del menú según el tipo de contribuyente."""
    opciones = [
        ("ingreso", "Registrar ingreso"),
        ("gasto", "Registrar gasto"),
    ]
    if tipo == "fisica":
        opciones.append(("deduccion", "Registrar deducción personal (médicos, colegiaturas...)"))
    else:
        opciones.append(("perdida", "Registrar pérdida fiscal de ejercicios anteriores"))
    opciones += [
        ("calcular", "Calcular impuestos"),
        ("educacion", "Educación financiera"),
        ("historial", "Ver historial"),
        ("listar", "Ver ingresos y gastos"),
        ("salir", "Salir"),
    ]
    return opciones

def mostrar_menu(tipo):
    opciones = opciones_menu(tipo)
    print(f"Menú FiscoSim ({nombre_tipo(tipo)}):")
    for numero, (clave, texto) in enumerate(opciones, start=1):
        print(f"{numero}. {texto}")
    opcion = input(f"Elige una opción (1-{len(opciones)}): ").strip()
    if opcion.isdigit() and 1 <= int(opcion) <= len(opciones):
        return opciones[int(opcion) - 1][0]
    return None

def main():
    print("Bienvenido a FiscoSim")
    nombre = input("Escribe tu nombre: ")
    tipo = elegir_tipo_contribuyente()
    tipo_actividad = input("Escribe tu tipo de actividad (freelance, comercio, servicios...): ")
    print()

    while True:
        opcion = mostrar_menu(tipo)
        if opcion == "ingreso":
            registrar_ingreso()
        elif opcion == "gasto":
            registrar_gasto()
        elif opcion == "deduccion":
            registrar_deduccion_personal()
        elif opcion == "perdida":
            registrar_perdida_anterior()
        elif opcion == "calcular":
            calcular_y_mostrar(nombre, tipo, tipo_actividad)
        elif opcion == "educacion":
            modulo_educacion(tipo)
        elif opcion == "historial":
            ver_historial()
        elif opcion == "listar":
            listar_registros(tipo)
        elif opcion == "salir":
            print("Hasta pronto!")
            break
        else:
            print("Opción no válida\n")

if __name__ == "__main__":
    main()
